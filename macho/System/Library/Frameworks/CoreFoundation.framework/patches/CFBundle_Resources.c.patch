+// Looks a resource up in a query table. When the exact name is not there, the names of the table are folded (decomposed, case and width
+// insensitive) once, kept on the table, and the folded name is looked up: resources are found whatever the case of the file system.
+CF_PRIVATE const void *__CFBundleQueryTableGetValue(CFDictionaryRef table, CFStringRef key) {
+    static char foldedNamesKey;
+    const void *value = CFDictionaryGetValue(table, key);
+    if (value || !key) return value;
+    CFMutableDictionaryRef folded = (CFMutableDictionaryRef)objc_getAssociatedObject((id)table, &foldedNamesKey);
+    if (!folded) {
+        CFIndex count = CFDictionaryGetCount(table);
+        size_t size = (count + (count == 0)) * sizeof(void *);
+        const void **keys = malloc(size);
+        const void **values = malloc(size);
+        CFDictionaryGetKeysAndValues(table, keys, values);
+        folded = CFDictionaryCreateMutable(kCFAllocatorSystemDefault, count, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+        for (CFIndex idx = 0; idx < count; idx++) {
+            if (CFGetTypeID(keys[idx]) != CFStringGetTypeID()) continue;
+            CFMutableStringRef name = CFStringCreateMutableCopy(kCFAllocatorSystemDefault, 0, (CFStringRef)keys[idx]);
+            CFStringNormalize(name, kCFStringNormalizationFormD);
+            CFStringFold(name, kCFCompareCaseInsensitive, NULL);
+            CFDictionaryAddValue(folded, name, values[idx]);
+            CFRelease(name);
+        }
+        free(keys);
+        free(values);
+        objc_setAssociatedObject((id)table, &foldedNamesKey, (id)folded, OBJC_ASSOCIATION_RETAIN);
+        CFRelease(folded);
+    }
+    CFMutableStringRef name = CFStringCreateMutableCopy(kCFAllocatorSystemDefault, 0, key);
+    CFStringNormalize(name, kCFStringNormalizationFormD);
+    CFStringFold(name, kCFCompareCaseInsensitive, NULL);
+    value = CFDictionaryGetValue(folded, name);
+    CFRelease(name);
+    return value;
+}
