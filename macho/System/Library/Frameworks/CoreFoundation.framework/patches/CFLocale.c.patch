+// Fills __CFLocaleHostIdentifier and __CFLocaleHostPreferences on first use (the lock is held). The language comes from the host languages;
+// the country from services.conf (Region/region), else LC_TIME, else LANG, else the country of the language.
+static void __CFLocaleReadHostLocked(void) {
+    if (__CFLocaleHostPreferences) return;
+    CFAllocatorRef allocator = kCFAllocatorSystemDefault;
+    CFArrayRef languages = __CFLocaleCopyHostLanguages();
+    CFStringRef first = CFArrayGetCount(languages) ? (CFStringRef)CFArrayGetValueAtIndex(languages, 0) : CFSTR("en");
+    CFDictionaryRef languageComponents = CFLocaleCreateComponentsFromLocaleIdentifier(allocator, first);
+    CFStringRef path = __CFLocaleCopyConfigPath();
+    CFTypeRef country = NULL;
+    CFStringRef region = path ? __CFLocaleCopyFileValue(path, CFSTR("Region"), CFSTR("region")) : NULL;
+    if (region) {
+        CFMutableStringRef upper = CFStringCreateMutableCopy(allocator, 0, region);
+        CFRelease(region);
+        CFStringUppercase(upper, NULL);
+        country = upper;
+    } else {
+        CFStringRef value = __CFLocaleCopySystemValue(CFSTR("LC_TIME"));
+        if (!value) value = __CFLocaleCopySystemValue(CFSTR("LANG"));
+        CFDictionaryRef components = value ? CFLocaleCreateComponentsFromLocaleIdentifier(allocator, value) : NULL;
+        if (components) country = CFDictionaryGetValue(components, kCFLocaleCountryCode);
+        if (!country) country = CFDictionaryGetValue(languageComponents, kCFLocaleCountryCode);
+        if (country) CFRetain(country);
+        if (components) CFRelease(components);
+        if (value) CFRelease(value);
+    }
+    CFMutableDictionaryRef merged = CFDictionaryCreateMutableCopy(allocator, 0, languageComponents);
+    if (country) CFDictionarySetValue(merged, kCFLocaleCountryCode, country);
+    CFStringRef identifier = CFLocaleCreateLocaleIdentifierFromComponents(allocator, merged);
+    __CFLocaleHostIdentifier = CFLocaleCreateCanonicalLocaleIdentifierFromString(allocator, identifier);
+    __CFLocaleHostPreferences = __CFLocaleCreateHostPreferences(path, __CFLocaleHostIdentifier);
+    CFRelease(identifier);
+    CFRelease(merged);
+    if (country) CFRelease(country);
+    if (path) CFRelease(path);
+    CFRelease(languageComponents);
+}
