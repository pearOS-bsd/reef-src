+// The settings of the host as the preferences a Mac user would have (AppleLocale, AppleFirstWeekday, AppleICUForce24HourTime, AppleMetricUnits ...).
+static CFDictionaryRef __CFLocaleCreateHostPreferences(CFStringRef path, CFStringRef identifier) {
+    CFAllocatorRef allocator = kCFAllocatorSystemDefault;
+    CFMutableDictionaryRef prefs = CFDictionaryCreateMutable(allocator, 0, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+    if (identifier) CFDictionarySetValue(prefs, CFSTR("AppleLocale"), identifier);
+    if (!path) return prefs;
+    CFStringRef value = __CFLocaleCopyFileValue(path, CFSTR("Region"), CFSTR("firstWeekday"));
+    if (value) {
+        int day = CFStringGetIntValue(value);
+        if (day >= 1 && day <= 7) {     // 1 Monday ... 7 Sunday in the file, 1 Sunday ... 7 Saturday in CF
+            CFIndex weekday = (day % 7) + 1;
+            CFNumberRef number = CFNumberCreate(allocator, kCFNumberCFIndexType, &weekday);
+            CFStringRef keys[1] = {kCFGregorianCalendar};
+            CFTypeRef values[1] = {number};
+            CFDictionaryRef byCalendar = CFDictionaryCreate(allocator, (const void **)keys, (const void **)values, 1, &kCFTypeDictionaryKeyCallBacks, &kCFTypeDictionaryValueCallBacks);
+            CFDictionarySetValue(prefs, CFSTR("AppleFirstWeekday"), byCalendar);
+            CFRelease(byCalendar);
+            CFRelease(number);
+        }
+        CFRelease(value);
+    }
+    value = __CFLocaleCopyFileValue(path, CFSTR("Region"), CFSTR("twentyFourHour"));
+    if (value) {
+        if (CFEqual(value, CFSTR("true"))) CFDictionarySetValue(prefs, CFSTR("AppleICUForce24HourTime"), kCFBooleanTrue);
+        else if (CFEqual(value, CFSTR("false"))) CFDictionarySetValue(prefs, CFSTR("AppleICUForce12HourTime"), kCFBooleanTrue);
+        CFRelease(value);
+    }
+    value = __CFLocaleCopyFileValue(path, CFSTR("Region"), CFSTR("measurement"));
+    if (value) {
+        CFStringRef units = NULL;
+        CFBooleanRef metric = NULL;
+        if (CFEqual(value, CFSTR("us"))) { metric = kCFBooleanFalse; units = CFSTR("Inches"); }
+        else if (CFEqual(value, CFSTR("uk"))) { metric = kCFBooleanTrue; units = CFSTR("Inches"); }
+        else if (CFEqual(value, CFSTR("metric"))) { metric = kCFBooleanTrue; units = CFSTR("Centimeters"); }
+        if (metric) {
+            CFDictionarySetValue(prefs, CFSTR("AppleMetricUnits"), metric);
+            CFDictionarySetValue(prefs, CFSTR("AppleMeasurementUnits"), units);
+        }
+        CFRelease(value);
+    }
+    value = __CFLocaleCopyFileValue(path, CFSTR("Region"), CFSTR("temperature"));
+    if (value) {
+        if (CFEqual(value, CFSTR("celsius"))) CFDictionarySetValue(prefs, CFSTR("AppleTemperatureUnit"), kCFLocaleTemperatureUnitCelsius);
+        else if (CFEqual(value, CFSTR("fahrenheit"))) CFDictionarySetValue(prefs, CFSTR("AppleTemperatureUnit"), kCFLocaleTemperatureUnitFahrenheit);
+        CFRelease(value);
+    }
+    return prefs;
+}
