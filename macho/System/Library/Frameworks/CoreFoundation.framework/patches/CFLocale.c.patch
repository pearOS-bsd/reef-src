+// A variable of /etc/default/locale or /etc/locale.conf (LANG=en_US.UTF-8@euro gives en_US); "C" and "POSIX" count as not set.
+static CFStringRef __CFLocaleCopySystemValue(CFStringRef key) {
+    static const char *const files[2] = {"/etc/default/locale", "/etc/locale.conf"};
+    CFAllocatorRef allocator = kCFAllocatorSystemDefault;
+    for (int file = 0; file < 2; file++) {
+        CFStringRef path = CFStringCreateWithCString(allocator, files[file], kCFStringEncodingUTF8);
+        CFStringRef value = __CFLocaleCopyFileValue(path, NULL, key);
+        CFRelease(path);
+        if (!value) continue;
+        CFMutableStringRef copy = CFStringCreateMutableCopy(allocator, 0, value);
+        CFRange dot = CFStringFind(copy, CFSTR("."), 0);
+        if (dot.location != kCFNotFound) {      // drop the character set, keep a modifier
+            CFRange at = CFStringFind(copy, CFSTR("@"), 0);
+            CFIndex end = at.location != kCFNotFound ? at.location : CFStringGetLength(copy);
+            if (end > dot.location) CFStringDelete(copy, CFRangeMake(dot.location, end - dot.location));
+        }
+        CFRelease(value);
+        if (CFStringGetLength(copy) == 0 || CFEqual(copy, CFSTR("C")) || CFEqual(copy, CFSTR("POSIX"))) {
+            CFRelease(copy);
+            continue;
+        }
+        return copy;
+    }
+    return NULL;
+}
