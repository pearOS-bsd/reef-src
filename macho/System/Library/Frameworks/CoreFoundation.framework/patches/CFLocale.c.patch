+static CFStringRef __CFLocaleCreateTrimmed(CFStringRef string) {
+    CFMutableStringRef trimmed = CFStringCreateMutableCopy(kCFAllocatorSystemDefault, 0, string);
+    CFStringTrimWhitespace(trimmed);
+    CFIndex length = CFStringGetLength(trimmed);
+    if (length > 1) {
+        UniChar first = CFStringGetCharacterAtIndex(trimmed, 0);
+        if ((first == '\'' || first == '"') && CFStringGetCharacterAtIndex(trimmed, length - 1) == first) {   // a quoted value
+            CFStringDelete(trimmed, CFRangeMake(length - 1, 1));
+            CFStringDelete(trimmed, CFRangeMake(0, 1));
+        }
+    }
+    return trimmed;
+}
