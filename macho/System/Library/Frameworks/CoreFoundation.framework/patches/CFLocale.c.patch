+// The value of `key=value` in the `[section]` of an ini file (the whole file when `section` is NULL); NULL when it is missing or empty.
+static CFStringRef __CFLocaleCopyFileValue(CFStringRef path, CFStringRef section, CFStringRef key) {
+    char fsPath[1024];
+    if (!CFStringGetFileSystemRepresentation(path, fsPath, sizeof(fsPath))) return NULL;
+    FILE *file = fopen(fsPath, "r");
+    if (!file) return NULL;
+    CFAllocatorRef allocator = kCFAllocatorSystemDefault;
+    CFMutableDataRef data = CFDataCreateMutable(allocator, 0);
+    char buffer[4096];
+    size_t got;
+    while ((got = fread(buffer, 1, sizeof(buffer), file)) != 0) {
+        if (CFDataGetLength(data) > 0xffff) break;
+        CFDataAppendBytes(data, (const UInt8 *)buffer, got);
+    }
+    fclose(file);
+    CFStringRef text = CFStringCreateWithBytes(allocator, CFDataGetBytePtr(data), CFDataGetLength(data), kCFStringEncodingUTF8, false);
+    CFRelease(data);
+    if (!text) return NULL;
+    CFArrayRef lines = CFStringCreateArrayBySeparatingStrings(allocator, text, CFSTR("\n"));
+    CFRelease(text);
+    CFStringRef prefix = CFStringCreateWithFormat(allocator, NULL, CFSTR("%@="), key);
+    CFStringRef header = section ? CFStringCreateWithFormat(allocator, NULL, CFSTR("[%@]"), section) : NULL;
+    CFStringRef value = NULL;
+    Boolean inSection = section == NULL;
+    for (CFIndex idx = 0, cnt = CFArrayGetCount(lines); idx < cnt && !value; idx++) {
+        CFStringRef line = __CFLocaleCreateTrimmed((CFStringRef)CFArrayGetValueAtIndex(lines, idx));
+        if (section && CFStringHasPrefix(line, CFSTR("["))) {
+            inSection = CFEqual(line, header);
+        } else if (inSection && CFStringHasPrefix(line, prefix)) {
+            CFIndex prefixLength = CFStringGetLength(prefix);
+            CFStringRef rest = CFStringCreateWithSubstring(allocator, line, CFRangeMake(prefixLength, CFStringGetLength(line) - prefixLength));
+            value = __CFLocaleCreateTrimmed(rest);
+            CFRelease(rest);
+            if (CFStringGetLength(value) == 0) {
+                CFRelease(value);
+                value = NULL;
+            }
+        }
+        CFRelease(line);
+    }
+    CFRelease(lines);
+    CFRelease(prefix);
+    if (header) CFRelease(header);
+    return value;
+}
