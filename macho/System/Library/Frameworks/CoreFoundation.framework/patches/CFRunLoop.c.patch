+// Descriptors that someone else acknowledges (NSRunLoop of Foundation: its own pipes and event descriptors). When one of them wakes the
+// loop, the loop does not read the 8 bytes itself.
+#define __CFWatchedDescriptorMax 8
+static int __CFWatchedDescriptors[__CFWatchedDescriptorMax];
+static int __CFWatchedDescriptorCount = 0;
+
+CF_EXPORT void _CFRunLoopWatchDescriptor(int fd) {
+    int count = __CFWatchedDescriptorCount;
+    if (count < __CFWatchedDescriptorMax) {
+        __CFWatchedDescriptors[count] = fd;
+        __sync_synchronize();
+        __CFWatchedDescriptorCount = count + 1;
+    }
+}
