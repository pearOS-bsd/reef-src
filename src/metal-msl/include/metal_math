namespace __math {

template <class T> struct bits_of;
template <> struct bits_of<float> {
    typedef uint type;
    typedef int signed_type;
    static constexpr int mantissa = 23;
    static constexpr int bias = 127;
    static constexpr uint exponent_mask = 0x7f800000u;
    static constexpr uint mantissa_mask = 0x007fffffu;
};
template <> struct bits_of<half> {
    typedef ushort type;
    typedef short signed_type;
    static constexpr int mantissa = 10;
    static constexpr int bias = 15;
    static constexpr ushort exponent_mask = 0x7c00;
    static constexpr ushort mantissa_mask = 0x03ff;
};

template <class T> using element = typename __msl::traits<T>::element;
template <class T> using unsigned_bits = typename __msl::conditional<__msl::traits<T>::vector,
    vec<typename bits_of<element<T>>::type, __msl::traits<T>::size>, typename bits_of<element<T>>::type>::type;
template <class T> using int_result = typename __msl::conditional<__msl::traits<T>::vector,
    vec<int, __msl::traits<T>::size>, int>::type;
template <class T> using bool_result = typename __msl::conditional<__msl::traits<T>::vector,
    __msl_bool_vector<__msl::traits<T>::size>, bool>::type;

template <class T> inline unsigned_bits<T> bits(T x)
{
    return as_type<unsigned_bits<T>>(x);
}

// mask ? a : b, elementwise for vectors.
template <class M, class T> inline T pick(M mask, T a, T b)
{
    if constexpr (__msl::traits<T>::vector) {
        T result {};
        for (int k = 0; k < __msl::traits<T>::size; ++k)
            result[k] = mask[k] ? a[k] : b[k];
        return result;
    } else {
        return mask ? a : b;
    }
}

template <class R, class M> inline R to_bool(M mask)
{
    if constexpr (__msl::traits<M>::vector)
        return R(mask);
    else
        return mask;
}

} // namespace __math

// Classification works on the bits, so fast math's no-NaN and no-infinity
// assumptions leave it intact.
#define __MSL_CLASSIFY(T, S, ...)                                                                                    \
    inline __math::bool_result<T> isnan(T x)                                                                         \
    {                                                                                                                \
        typedef __math::bits_of<__math::element<T>> B;                                                               \
        auto magnitude = __math::bits(x) & (B::exponent_mask | B::mantissa_mask);                                    \
        return __math::to_bool<__math::bool_result<T>>(magnitude > B::exponent_mask);                                \
    }                                                                                                                \
    inline __math::bool_result<T> isinf(T x)                                                                         \
    {                                                                                                                \
        typedef __math::bits_of<__math::element<T>> B;                                                               \
        auto magnitude = __math::bits(x) & (B::exponent_mask | B::mantissa_mask);                                    \
        return __math::to_bool<__math::bool_result<T>>(magnitude == B::exponent_mask);                               \
    }                                                                                                                \
    inline __math::bool_result<T> isfinite(T x)                                                                      \
    {                                                                                                                \
        typedef __math::bits_of<__math::element<T>> B;                                                               \
        return __math::to_bool<__math::bool_result<T>>((__math::bits(x) & B::exponent_mask) != B::exponent_mask);   \
    }                                                                                                                \
    inline __math::bool_result<T> isnormal(T x)                                                                      \
    {                                                                                                                \
        typedef __math::bits_of<__math::element<T>> B;                                                               \
        auto exponent = __math::bits(x) & B::exponent_mask;                                                          \
        return __math::to_bool<__math::bool_result<T>>(exponent != 0 && exponent != B::exponent_mask);               \
    }                                                                                                                \
    inline __math::bool_result<T> signbit(T x)                                                                       \
    {                                                                                                                \
        return __math::to_bool<__math::bool_result<T>>((__math::bits(x) >> (8 * sizeof(__math::element<T>) - 1)) != 0); \
    }                                                                                                                \
    inline __math::bool_result<T> isordered(T x, T y)                                                                \
    {                                                                                                                \
        return !(isnan(x) || isnan(y));                                                                              \
    }                                                                                                                \
    inline __math::bool_result<T> isunordered(T x, T y)                                                              \
    {                                                                                                                \
        return isnan(x) || isnan(y);                                                                                 \
    }                                                                                                                \
    inline T modf(T x, thread T &integral)                                                                           \
    {                                                                                                                \
        integral = trunc(x);                                                                                         \
        return copysign(__math::pick(isinf(x), T(0), x - integral), x);                                             \
    }                                                                                                                \
    inline T sincos(T x, thread T &cosine)                                                                           \
    {                                                                                                                \
        cosine = cos(x);                                                                                             \
        return sin(x);                                                                                               \
    }                                                                                                                \
    inline __math::int_result<T> ilogb(T x)                                                                          \
    {                                                                                                                \
        typedef __math::bits_of<__math::element<T>> B;                                                               \
        auto exponent = (__math::bits(x) & B::exponent_mask) >> B::mantissa;                                         \
        return __msl::convert<__math::int_result<T>>(exponent) - B::bias;                                            \
    }                                                                                                                \
    inline T ldexp(T x, __math::int_result<T> k)                                                                     \
    {                                                                                                                \
        return x * exp2(__msl::convert<T>(k));                                                                       \
    }                                                                                                                \
    inline T frexp(T x, thread __math::int_result<T> &exponent)                                                      \
    {                                                                                                                \
        typedef __math::bits_of<__math::element<T>> B;                                                               \
        auto raw = __math::bits(x);                                                                                  \
        auto biased = (raw & B::exponent_mask) >> B::mantissa;                                                       \
        auto zero = (raw & (B::exponent_mask | B::mantissa_mask)) == 0;                                              \
        exponent = __math::pick(zero, __math::int_result<T>(0),                                                      \
            __msl::convert<__math::int_result<T>>(biased) - (B::bias - 1));                                          \
        __math::unsigned_bits<T> fraction = (raw & __math::unsigned_bits<T>(~B::exponent_mask))                     \
            | (__math::unsigned_bits<T>(B::bias - 1) << B::mantissa);                                                \
        return __math::pick(zero, x, as_type<T>(fraction));                                                          \
    }

__MSL_EACH_FLOAT(__MSL_CLASSIFY)

