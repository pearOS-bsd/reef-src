template <class T, access A = access::sample> struct texture1d {
    __MSL_TEXTURE_COMMON(texture_1d)
    vec<T, 4> sample(sampler s, float x) const
    {
        return __texture::ops<T>::sample_1d(__h, s.__handle(), x);
    }
    vec<T, 4> read(uint x, uint lod = 0) const
    {
        return __texture::ops<T>::read_1d(__h, x, lod);
    }
    vec<T, 4> read(ushort x, ushort lod = 0) const
    {
        return read(uint(x), uint(lod));
    }
    void write(vec<T, 4> color, uint x, uint lod = 0) const
    {
        __texture::ops<T>::write_1d(__h, x, color, lod);
    }
};

