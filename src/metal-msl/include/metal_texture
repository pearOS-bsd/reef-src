constant _sampler_t *__msl_constant_sampler(ulong state) __asm__("reef.msl.constant_sampler");

namespace metal {

struct sampler {
    constant _sampler_t *__h;
    ulong __state;

    constexpr sampler()
        : __h(nullptr)
        , __state(__sampler::make())
    {
    }

    template <class... A, class = __msl::enable_if_t<(sizeof...(A) > 0) && (true && ... && __sampler::is_option<A>::value)>>
    constexpr sampler(A... options)
        : __h(nullptr)
        , __state(__sampler::make(options...))
    {
    }

    constant _sampler_t *__handle() const
    {
        return __h ? __h : __msl_constant_sampler(__state);
    }
};

