        static V read_1d_array(handle, uint, uint, uint) __asm__("reef.msl.read_texture_1d_array." S);               \
        static V read_2d(handle, uint2, uint) __asm__("reef.msl.read_texture_2d." S);                                \
        static V read_2d_array(handle, uint2, uint, uint) __asm__("reef.msl.read_texture_2d_array." S);              \
