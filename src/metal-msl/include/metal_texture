template <class T, access A = access::sample> struct texture2d {
    __MSL_TEXTURE_COMMON(texture_2d)
    __MSL_TEXTURE_HEIGHT(texture_2d)
    vec<T, 4> sample(sampler s, float2 coord, int2 offset = int2(0)) const
    {
        return __texture::ops<T>::sample_2d(__h, s.__handle(), coord, true, offset, false, 0.0f, 0.0f, 0);
    }
    vec<T, 4> sample(sampler s, float2 coord, bias options, int2 offset = int2(0)) const
    {
        return __texture::ops<T>::sample_2d(__h, s.__handle(), coord, true, offset, true, options.value, 0.0f, 0);
    }
    vec<T, 4> sample(sampler s, float2 coord, level options, int2 offset = int2(0)) const
    {
        return __texture::ops<T>::sample_2d(__h, s.__handle(), coord, true, offset, true, options.lod, 0.0f, 1);
    }
    vec<T, 4> sample(sampler s, float2 coord, min_lod_clamp options, int2 offset = int2(0)) const
    {
        return __texture::ops<T>::sample_2d(__h, s.__handle(), coord, true, offset, false, 0.0f, options.value, 0);
    }
    vec<T, 4> sample(sampler s, float2 coord, bias b, min_lod_clamp c, int2 offset = int2(0)) const
    {
        return __texture::ops<T>::sample_2d(__h, s.__handle(), coord, true, offset, true, b.value, c.value, 0);
    }
    vec<T, 4> sample(sampler s, float2 coord, gradient2d options, int2 offset = int2(0)) const
    {
        return __texture::ops<T>::sample_2d_grad(__h, s.__handle(), coord, options.dPdx, options.dPdy, 0.0f, true,
            offset);
    }
    vec<T, 4> sample(sampler s, float2 coord, gradient2d options, min_lod_clamp c, int2 offset = int2(0)) const
    {
        return __texture::ops<T>::sample_2d_grad(__h, s.__handle(), coord, options.dPdx, options.dPdy, c.value,
            true, offset);
    }
    vec<T, 4> gather(sampler s, float2 coord, int2 offset = int2(0), component c = component::x) const
    {
        return __texture::ops<T>::gather_2d(__h, s.__handle(), coord, true, offset, int(c));
    }
    vec<T, 4> read(uint2 coord, uint lod = 0) const
    {
        return __texture::ops<T>::read_2d(__h, coord, lod);
    }
    vec<T, 4> read(ushort2 coord, ushort lod = 0) const
    {
        return read(uint2(coord), uint(lod));
    }
    void write(vec<T, 4> color, uint2 coord, uint lod = 0) const
    {
        __texture::ops<T>::write_2d(__h, coord, color, lod);
    }
