namespace __sampler {

struct state {
    int s = 1;
    int t = 1;
    int r = 1;
    int mag = 0;
    int min = 0;
    int mip = 0;
    int anisotropy = 1;
    int pixel = 0;
    int border = 0;
    int compare = 0;
    float lodMin = 0.0f;
    float lodMax = 0x1.fffffep+127f;
};

constexpr void apply(state &st, coord value)
{
    st.pixel = value == coord::pixel;
}
constexpr void apply(state &st, address value)
{
    st.s = st.t = st.r = int(value);
}
constexpr void apply(state &st, s_address value)
{
    st.s = int(value);
}
constexpr void apply(state &st, t_address value)
{
    st.t = int(value);
}
constexpr void apply(state &st, r_address value)
{
    st.r = int(value);
}
constexpr void apply(state &st, filter value)
{
    st.mag = st.min = int(value);
}
constexpr void apply(state &st, mag_filter value)
{
    st.mag = int(value);
}
constexpr void apply(state &st, min_filter value)
{
    st.min = int(value);
}
constexpr void apply(state &st, mip_filter value)
{
    st.mip = int(value);
}
constexpr void apply(state &st, compare_func value)
{
    st.compare = int(value);
}
constexpr void apply(state &st, border_color value)
{
    st.border = int(value);
}
constexpr void apply(state &st, max_anisotropy value)
{
    st.anisotropy = value.value;
}
constexpr void apply(state &st, lod_clamp value)
{
    st.lodMin = value.min;
    st.lodMax = value.max;
}

// IEEE half bits of a level of detail, rounded to nearest and capped at
// the largest finite half.
constexpr ulong halfBits(float value)
{
    if (!(value > 0.0f))
        return 0;
    if (value >= 65504.0f)
        return 0x7bff;
    const uint bits = __builtin_bit_cast(uint, value);
    const int exponent = int((bits >> 23) & 0xff) - 127 + 15;
    uint mantissa = (bits & 0x7fffff) | 0x800000;
    if (exponent <= 0) {
        const int shift = 14 - exponent;
        if (shift > 24)
            return 0;
        return (mantissa + (1u << (shift - 1))) >> shift;
    }
    uint result = (uint(exponent) << 10) | ((mantissa & 0x7fffff) >> 13);
    if (mantissa & 0x1000)
        ++result;
    return result > 0x7bff ? 0x7bff : result;
}

// The packed state: address modes in bits 0-8, magnification, minification
// and mip filters in 9-14, pixel coordinates in 15, border colour in 16-17,
// anisotropy in 19-23, the level of detail clamp as two halves in 24-55,
// the compare function in 56-59, bit 63 set.
constexpr ulong encode(const state &st)
{
    return ulong(st.s) | ulong(st.t) << 3 | ulong(st.r) << 6 | ulong(st.mag) << 9 | ulong(st.min) << 11
        | ulong(st.mip) << 13 | ulong(st.pixel) << 15 | ulong(st.border) << 16 | ulong(st.anisotropy & 31) << 19
        | halfBits(st.lodMin) << 24 | halfBits(st.lodMax) << 40 | ulong(st.compare) << 56 | 1ul << 63;
}

template <class T> struct is_option {
    static constexpr bool value = __msl::is_same<T, coord>::value || __msl::is_same<T, address>::value
        || __msl::is_same<T, s_address>::value || __msl::is_same<T, t_address>::value
        || __msl::is_same<T, r_address>::value || __msl::is_same<T, filter>::value
        || __msl::is_same<T, mag_filter>::value || __msl::is_same<T, min_filter>::value
        || __msl::is_same<T, mip_filter>::value || __msl::is_same<T, compare_func>::value
        || __msl::is_same<T, border_color>::value || __msl::is_same<T, max_anisotropy>::value
        || __msl::is_same<T, lod_clamp>::value;
};

template <class... A> constexpr ulong make(A... options)
{
    state st;
    (apply(st, options), ...);
    return encode(st);
}

