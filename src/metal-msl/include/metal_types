// A vector with each element stored on its own: bool vectors and packed
// three-component vectors. Swizzles are properties of a base that reaches
// the elements of the derived vector.
#define __MSL_SWIZZLE_MEMBER(name, length, writable, i0, i1, i2, i3)                                                 \
    template <int __L = length> typename __msl::swizzle_type<E, __L>::type __g_##name() const                        \
    {                                                                                                                \
        return static_cast<const D *>(this)->template __msl_pick<__L>(i0, i1, i2, i3);                               \
    }                                                                                                                \
    template <class V> void __p_##name(V value)                                                                      \
    {                                                                                                                \
        static_assert(writable || sizeof(V) == 0, "a swizzle that repeats a component cannot be assigned");        \
        static_cast<D *>(this)->template __msl_place<length>(value, i0, i1, i2, i3);                                 \
    }                                                                                                                \
    __declspec(property(get = __g_##name, put = __p_##name)) typename __msl::swizzle_type<E, length>::type name;

template <class D, class E, int N> struct __msl_swizzles;
template <class D, class E> struct __msl_swizzles<D, E, 2> {
    __MSL_SWIZZLES_2(__MSL_SWIZZLE_MEMBER)
};
template <class D, class E> struct __msl_swizzles<D, E, 3> {
    __MSL_SWIZZLES_3(__MSL_SWIZZLE_MEMBER)
};
template <class D, class E> struct __msl_swizzles<D, E, 4> {
    __MSL_SWIZZLES_4(__MSL_SWIZZLE_MEMBER)
};

#define __MSL_ELEMENTWISE_ACCESS                                                                                     \
    __element &operator[](int i)                                                                                     \
    {                                                                                                                \
        return __e[i];                                                                                               \
    }                                                                                                                \
    const __element &operator[](int i) const                                                                         \
    {                                                                                                                \
        return __e[i];                                                                                               \
    }                                                                                                                \
    template <int L> typename __msl::swizzle_type<__element, L>::type __msl_pick(int i0, int i1, int i2, int i3) const \
    {                                                                                                                \
        if constexpr (L == 1) {                                                                                      \
            return __e[i0];                                                                                          \
        } else {                                                                                                     \
            typename __msl::swizzle_type<__element, L>::type result {};                                              \
            const int indices[4] = {i0, i1, i2, i3};                                                                 \
            for (int k = 0; k < L; ++k)                                                                              \
                result[k] = __e[indices[k]];                                                                         \
            return result;                                                                                           \
        }                                                                                                            \
    }                                                                                                                \
    template <int L, class V> void __msl_place(V value, int i0, int i1, int i2, int i3)                             \
    {                                                                                                                \
        if constexpr (L == 1) {                                                                                      \
            __e[i0] = value;                                                                                         \
        } else {                                                                                                     \
            const int indices[4] = {i0, i1, i2, i3};                                                                 \
            for (int k = 0; k < L; ++k)                                                                              \
                __e[indices[k]] = value[k];                                                                          \
        }                                                                                                            \
    }

template <int N> struct __msl_bool_vector : __msl_swizzles<__msl_bool_vector<N>, bool, N> {
    typedef bool __element;
    alignas(N == 3 ? 4 : N) bool __e[N == 3 ? 4 : N];

    __msl_bool_vector() = default;
    constexpr __msl_bool_vector(bool value)
        : __e {}
    {
        for (int k = 0; k < N; ++k)
            __e[k] = value;
    }
    template <class V, class = __msl::enable_if_t<!__msl::is_scalar<V>::value>> __msl_bool_vector(V value)
    {
        static_assert(__msl::traits<V>::size == N, "a vector converts only to a vector with as many components");
        for (int k = 0; k < N; ++k)
            __e[k] = value[k] != 0;
    }
    template <class A, class B, class... R> __msl_bool_vector(A a, B b, R... rest);

    __msl_bool_vector operator!() const
    {
        __msl_bool_vector result;
        for (int k = 0; k < N; ++k)
            result.__e[k] = !__e[k];
        return result;
    }

    __MSL_ELEMENTWISE_ACCESS
};

