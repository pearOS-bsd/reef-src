// Vector constructors: float4(x), float4(xy, z, w) and the rest.
template <class V> constexpr V __msl_make()
{
    return V {};
}

template <class V, class A> constexpr V __msl_make(A value)
{
    typedef typename __msl::traits<V>::element E;
    if constexpr (__msl::traits<A>::vector) {
        static_assert(__msl::traits<A>::size == __msl::traits<V>::size,
            "a vector converts only to a vector with as many components");
        return __msl::convert<V>(value);
    } else {
        return V(E(value));
    }
}

template <class V, class A, class B, class... R> constexpr V __msl_make(A a, B b, R... rest)
{
    typedef typename __msl::traits<V>::element E;
    static_assert(__msl::traits<A>::size + __msl::traits<B>::size + (0 + ... + __msl::traits<R>::size)
            == __msl::traits<V>::size,
        "a vector constructor needs as many components as the vector has");
    if constexpr (!__msl::traits<A>::vector && !__msl::traits<B>::vector && (true && ... && !__msl::traits<R>::vector)) {
        return V {E(a), E(b), E(rest)...};
    } else {
        V result {};
        int next = 0;
        __msl::fill(result, next, a);
        __msl::fill(result, next, b);
        (__msl::fill(result, next, rest), ...);
        return result;
    }
}

template <int N>
template <class A, class B, class... R>
inline __msl_bool_vector<N>::__msl_bool_vector(A a, B b, R... rest)
{
    static_assert(__msl::traits<A>::size + __msl::traits<B>::size + (0 + ... + __msl::traits<R>::size) == N,
        "a vector constructor needs as many components as the vector has");
    int next = 0;
    __msl::fill(*this, next, a);
    __msl::fill(*this, next, b);
    (__msl::fill(*this, next, rest), ...);
}

template <int N> inline __msl_bool_vector<N> operator&&(__msl_bool_vector<N> a, __msl_bool_vector<N> b)
{
    __msl_bool_vector<N> result;
    for (int k = 0; k < N; ++k)
        result[k] = a[k] && b[k];
    return result;
}

template <int N> inline __msl_bool_vector<N> operator||(__msl_bool_vector<N> a, __msl_bool_vector<N> b)
{
    __msl_bool_vector<N> result;
    for (int k = 0; k < N; ++k)
        result[k] = a[k] || b[k];
    return result;
}

template <int N> inline __msl_bool_vector<N> operator==(__msl_bool_vector<N> a, __msl_bool_vector<N> b)
{
    __msl_bool_vector<N> result;
    for (int k = 0; k < N; ++k)
        result[k] = a[k] == b[k];
    return result;
}

template <int N> inline __msl_bool_vector<N> operator!=(__msl_bool_vector<N> a, __msl_bool_vector<N> b)
{
    __msl_bool_vector<N> result;
    for (int k = 0; k < N; ++k)
        result[k] = a[k] != b[k];
    return result;
}

template <int N> inline __msl_bool_vector<N> operator&(__msl_bool_vector<N> a, __msl_bool_vector<N> b)
{
    return a && b;
}

template <int N> inline __msl_bool_vector<N> operator|(__msl_bool_vector<N> a, __msl_bool_vector<N> b)
{
    return a || b;
}

template <int N> inline __msl_bool_vector<N> operator^(__msl_bool_vector<N> a, __msl_bool_vector<N> b)
{
    return a != b;
}

// Three-component vectors in three elements' space, for buffers laid out
// without padding.
template <class T> struct __msl_packed3 : __msl_swizzles<__msl_packed3<T>, T, 3> {
    typedef T __element;
    T __e[3];

    __msl_packed3() = default;
    constexpr __msl_packed3(T value)
        : __e {value, value, value}
    {
    }
    constexpr __msl_packed3(T a, T b, T c)
        : __e {a, b, c}
    {
    }
    __msl_packed3(vec<T, 3> value)
        : __e {value.x, value.y, value.z}
    {
    }
    template <class U, class = __msl::enable_if_t<!__msl::is_same<U, T>::value>>
    explicit __msl_packed3(vec<U, 3> value)
        : __e {T(value.x), T(value.y), T(value.z)}
    {
    }
    operator vec<T, 3>() const
    {
        return vec<T, 3> {__e[0], __e[1], __e[2]};
    }

    __MSL_ELEMENTWISE_ACCESS
};

#define __MSL_PACKED3_OPERATOR(OP)                                                                                   \
    template <class T> inline vec<T, 3> operator OP(__msl_packed3<T> a, vec<T, 3> b)                                 \
    {                                                                                                                \
        return vec<T, 3>(a) OP b;                                                                                    \
    }                                                                                                                \
    template <class T> inline vec<T, 3> operator OP(vec<T, 3> a, __msl_packed3<T> b)                                 \
    {                                                                                                                \
        return a OP vec<T, 3>(b);                                                                                    \
    }                                                                                                                \
    template <class T> inline vec<T, 3> operator OP(__msl_packed3<T> a, __msl_packed3<T> b)                          \
    {                                                                                                                \
        return vec<T, 3>(a) OP vec<T, 3>(b);                                                                         \
    }                                                                                                                \
    template <class T> inline vec<T, 3> operator OP(__msl_packed3<T> a, T b)                                         \
    {                                                                                                                \
        return vec<T, 3>(a) OP b;                                                                                    \
    }                                                                                                                \
    template <class T> inline vec<T, 3> operator OP(T a, __msl_packed3<T> b)                                         \
    {                                                                                                                \
        return a OP vec<T, 3>(b);                                                                                    \
    }

__MSL_PACKED3_OPERATOR(+)
