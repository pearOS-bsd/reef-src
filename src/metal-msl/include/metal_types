// Scalars, vectors and the elementwise vectors alike: a size, an element
// type and element access.
template <class T> struct traits {
    static constexpr int size = 1;
    static constexpr bool vector = false;
    typedef T element;
};
template <class T, int N> struct traits<T __attribute__((ext_vector_type(N)))> {
    static constexpr int size = N;
    static constexpr bool vector = true;
    typedef T element;
};
template <int N> struct traits<__msl_bool_vector<N>> {
    static constexpr int size = N;
    static constexpr bool vector = true;
    typedef bool element;
};
template <class T> struct traits<__msl_packed3<T>> {
    static constexpr int size = 3;
    static constexpr bool vector = true;
    typedef T element;
};

template <class T> struct is_ext_vector {
    static constexpr bool value = false;
};
template <class T, int N> struct is_ext_vector<T __attribute__((ext_vector_type(N)))> {
    static constexpr bool value = true;
};

template <class T> inline typename traits<T>::element element(T value, int i)
{
    if constexpr (traits<T>::vector)
        return value[i];
    else
        return value;
}

template <class V, class A> inline void fill(V &result, int &next, A value)
{
    typedef typename traits<V>::element E;
    if constexpr (traits<A>::vector) {
        for (int k = 0; k < traits<A>::size; ++k)
            result[next++] = E(value[k]);
    } else {
        result[next++] = E(value);
    }
}

template <class V, class A> inline V convert(A value)
{
    if constexpr (!traits<V>::vector) {
        return V(value);
    } else if constexpr (is_ext_vector<V>::value && is_ext_vector<A>::value) {
        return __builtin_convertvector(value, V);
    } else if constexpr (is_ext_vector<V>::value && is_same<typename traits<A>::element, bool>::value) {
        typedef bool B __attribute__((ext_vector_type(traits<V>::size)));
        B bits {};
        for (int k = 0; k < traits<V>::size; ++k)
            bits[k] = value[k];
        return __builtin_convertvector(bits, V);
    } else {
        typedef typename traits<V>::element E;
        V result {};
        for (int k = 0; k < traits<V>::size; ++k)
            result[k] = E(value[k]);
        return result;
    }
}

