# Lets reef (and the WebKit sandbox it starts through bwrap) create user namespaces, as Ubuntu allows epiphany.
abi <abi/4.0>,
include <tunables/global>

profile reef /usr/bin/reef flags=(unconfined) {
  userns,

  # Site-specific additions and overrides. See local/README for details.
  include if exists <local/reef>
}
